# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# --- UET-LMS (Canvas) ---
CANVAS_BASE_URL=https://portal.uet.vnu.edu.vn
# Account > Settings > New Access Token
CANVAS_TOKEN=

# --- LLM (gói miễn phí; điền ít nhất một khoá) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Dự phòng khi Gemini hết hạn mức (tuỳ chọn)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Thứ tự thử các nhà cung cấp
LLM_ORDER=gemini,groq,openrouter

# --- Tuỳ chọn ---
MAX_QUIZZES=2
QUESTIONS_PER_QUIZ=8
LOOKAHEAD_DAYS=14
